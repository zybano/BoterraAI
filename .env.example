# Claude API key — enables live agents. Without it the app runs in demo mode.
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-opus-5-5)
# BOTERRA_MODEL=claude-opus-5-5

# Required in production: secret used to sign session cookies (any long random string)
AUTH_SECRET=

# Optional: where the JSON data store lives (default ./.data)
# BOTERRA_DATA_DIR=

# Optional: shared secret for POST /api/cron/routines (scheduled routines)
# CRON_SECRET=
